# SmartText AI — example environment file (placeholders only).
#
# This file is ONLY used by the browser development server (npm run server / npm run dev:web).
# The desktop app does NOT read .env: in the desktop app you enter keys in Settings → AI providers
# and they are stored in the operating system keychain.
#
# Copy to .env and fill in the keys you want to use. Never commit .env (it is in .gitignore).

# OpenAI — https://platform.openai.com/api-keys (text + image generation)
OPENAI_API_KEY=

# Anthropic (Claude) — https://console.anthropic.com/ (text)
ANTHROPIC_API_KEY=

# Optional key for an OpenAI-compatible server (OpenRouter, a hosted vLLM, …).
# Local servers such as Ollama or LM Studio usually need no key.
OPENAI_COMPATIBLE_API_KEY=

# Port of the local development proxy (Vite forwards /api to it).
SMARTTEXT_SERVER_PORT=8787
